# Required, no defaults. The service refuses to start when one is missing or empty.
# Postgres connection string (a secret: keep the real value out of git).
DATABASE_URL=postgresql://user:password@host:5432/parking
# GCP project that owns the Pub/Sub topics reservation-*-v1.
GCP_PROJECT=my-project
# Audience the ID tokens of every caller must carry: the service's own URL.
AUTH_AUDIENCE=https://parking-reservation-xxxx.run.app
# Service account email of the authenticating front end: the only caller of /v1/*.
FRONT_END_SERVICE_ACCOUNT=front-end@my-project.iam.gserviceaccount.com
# Service account email of Cloud Scheduler: the only caller of /internal/*.
SCHEDULER_SERVICE_ACCOUNT=scheduler@my-project.iam.gserviceaccount.com
